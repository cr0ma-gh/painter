<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Painter</string>
	<key>CFBundleExecutable</key>
	<string>Painter</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.cr0ma-gh.painter</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Painter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<!-- Full screen without a storyboard (otherwise iOS letterboxes the app). -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<!-- Let UIStatusBarHidden apply (the app's view controller would decide otherwise). -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!-- File → Import → From Scanner: the document camera. -->
	<key>NSCameraUsageDescription</key>
	<string>Painter uses the camera to scan sketches and pages into your drawing.</string>
	<!-- Network scanners (eSCL / AirScan): found with Bonjour on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Painter looks for scanners on your network so you can scan sketches into your drawing.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_uscan._tcp</string>
	</array>
	<!-- The Documents folder shows up as "Painter" in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon-152</string>
                <string>AppIcon-167</string>
            </array>
        </dict>
    </dict>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon-120</string>
                <string>AppIcon-180</string>
            </array>
        </dict>
    </dict>
</dict>
</plist>
