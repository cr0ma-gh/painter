# Antigravity Runner Environment Configuration
# Copy this file to .env and insert your API keys

# Gemini API Key for Google Antigravity (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Anthropic API Key for Claude Code
# ANTHROPIC_API_KEY=

# Optional: Default AI engine preference: 'auto', 'antigravity', or 'claude'
# ANTIGRAVITY_ENGINE=antigravity

# Optional: Polling interval in seconds
# ANTIGRAVITY_INTERVAL=60
